#!/usr/bin/env bash
# Register the three recurring passes with the Gateway's scheduler.
#
# Run from a checkout, on Zach's laptop, after `scripts/deploy-workspace` has
# put the prompt files on the box. Idempotent, like configure-imap: rerunning
# it is the way back to a known set of jobs.
#
# Each job is removed and recreated rather than edited in place. `--agent` is
# honoured on create and silently ignored on an update, and a trigger with no
# owner fails every single run with AGENT_SELECTION_REQUIRED.
#
# Usage: scripts/configure-automations

set -euo pipefail

export AWS_PROFILE="${AWS_PROFILE:-ZACH-ROOT}"
export AWS_PAGER=""

cd "$(dirname "$0")/.."
instance="$(tofu -chdir=tofu output -raw instance_id)"

read -r -d '' remote_script <<'REMOTE' || true
set -euo pipefail
oc() { sudo -iu openclaw openclaw "$@"; }
A=/srv/ichabod/automations

[ -f "$A/director.md" ] || { echo "no $A/director.md — run scripts/deploy-workspace first" >&2; exit 1; }

# Names are ours, ids are the scheduler's, so an id has to be looked up rather
# than remembered. trigger-probe is included because the probes used while
# working this out should not outlive it.
ids="$(oc automations list --all --json | python3 -c '
import json, sys
ours = {"director", "scout", "digest", "trigger-probe"}
print(" ".join(j["id"] for j in json.load(sys.stdin)["jobs"] if j["name"] in ours))
')"
for id in $ids; do
  oc automations rm "$id" > /dev/null
  echo "removed $id"
done

# The two isolated jobs pass --no-deliver. Delivery defaults to a chat channel
# this box does not have, and a job that cannot deliver fails closed even when
# the work itself succeeded — which is what the stock heartbeat job had been
# doing, unnoticed, for forty consecutive runs. A main-session system event has
# no delivery to disable, and the CLI rejects the flag there.

# Director. Hourly is the deliberate trade: a card can wait up to an hour,
# and the box pays for 24 model sessions a day instead of 288. automations/
# README.md has the note on making this event-driven later.
#
# A job targeting the main session cannot carry --message: the CLI refuses with
# "Main jobs require --system-event or --script". The pass wants the main
# session's continuity, so the prompt goes in as a system event instead, and
# --wake now means it does not sit waiting for a heartbeat that is about to be
# disabled two blocks down.
oc automations add --name director --display-name "Director pass" \
  --agent ichabod --session main --every 1h --wake now \
  --system-event "$(cat "$A/director.md")" \
  --timeout-seconds 1800 > /dev/null
echo "added director"

# Scout and digest run in isolated sessions. Both are short, self-contained,
# and read what they need off the board, so neither has any business landing in
# the middle of whatever the main session is doing.
oc automations add --name scout --display-name "Scout pass" \
  --agent ichabod --session isolated --cron "0 9 * * *" --tz America/Denver \
  --message "$(cat "$A/scout.md")" \
  --timeout-seconds 900 --no-deliver > /dev/null
echo "added scout"

oc automations add --name digest --display-name "Daily digest" \
  --agent ichabod --session isolated --cron "0 7 * * *" --tz America/Denver \
  --message "$(cat "$A/digest.md")" \
  --timeout-seconds 900 --no-deliver > /dev/null
echo "added digest"

# The stock heartbeat job wakes ichabod every 30 minutes with an empty payload
# and no route to deliver it, so every run ends "heartbeat skipped: no-route" —
# forty consecutive skips by the time anyone looked. The director pass is the
# real loop, so the heartbeat is only noise that would hide a real failure in
# the run history.
#
# It cannot be removed with `automations rm`: it is system-owned, and the CLI
# refuses with "system-owned monitor jobs cannot be edited by cron clients".
# The job exists because this config key exists, so the key is what goes.
if oc config get agents.defaults.heartbeat > /dev/null 2>&1; then
  oc config unset agents.defaults.heartbeat
  # System-owned jobs are reconciled at startup, so the job outlives the config
  # change until the Gateway restarts. This restarts ichabod's session too.
  sudo -iu openclaw systemctl --user restart openclaw-gateway
  sleep 8
  sudo -iu openclaw systemctl --user is-active openclaw-gateway
  echo "heartbeat: config key removed"
else
  echo "heartbeat: already absent"
fi

oc automations list
REMOTE

# SSM runs each command with sh, which has no `pipefail`, so the script rides
# over base64-encoded and is handed to bash on the far side. Same shape as
# configure-imap.
payload="$(printf '%s' "$remote_script" | base64 | tr -d '\n')"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

remote="echo $payload | base64 -d > /tmp/configure-automations.sh && bash /tmp/configure-automations.sh"
printf '{"commands":["%s"]}' "$remote" > "$tmp/params.json"

command_id="$(aws ssm send-command --instance-ids "$instance" \
  --document-name AWS-RunShellScript \
  --parameters "file://$tmp/params.json" \
  --query Command.CommandId --output text)"
echo "sent $command_id, waiting..."

aws ssm wait command-executed --command-id "$command_id" --instance-id "$instance" 2>/dev/null || true

aws ssm get-command-invocation --command-id "$command_id" --instance-id "$instance" \
  --query '[StandardOutputContent,StandardErrorContent]' --output text

status="$(aws ssm get-command-invocation --command-id "$command_id" --instance-id "$instance" \
  --query Status --output text)"
[ "$status" = "Success" ] || { echo "configure-automations failed: $status" >&2; exit 1; }
