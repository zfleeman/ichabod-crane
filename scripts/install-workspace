#!/usr/bin/env bash
# Runs on the box as root, unpacked from the payload scripts/deploy-workspace sends.
# Installs the policy files Zach owns and seeds the ones Ichabod owns.

set -euo pipefail

src="$(cd "$(dirname "$0")/.." && pwd)"
ws=/home/openclaw/.openclaw/workspace
mr=/home/openclaw/.openclaw/workspace-mail-reader
templates=/srv/ichabod/templates

install -d -o openclaw -g openclaw "$ws" "$ws/memory" "$ws/skills" "$mr" "$templates"

# Zach's files. Overwritten every deploy: Git is the source of truth and the
# box never edits them.
for f in AGENTS.md SOUL.md IDENTITY.md; do
  install -o openclaw -g openclaw -m 0644 "$src/workspace/$f" "$ws/$f"
  echo "installed $ws/$f"
done

# Skills Zach owns, one directory each. Only the names shipped in the repo are
# replaced, so a skill Ichabod wrote for himself is left alone — which is what
# AGENTS.md promises him under "Who owns which file".
for d in "$src"/workspace/skills/*/; do
  [ -d "$d" ] || continue
  name="$(basename "$d")"
  rm -rf "$ws/skills/$name"
  cp -R "$d" "$ws/skills/$name"
  chown -R openclaw:openclaw "$ws/skills/$name"
  chmod -R u=rwX,go=rX "$ws/skills/$name"
  echo "installed $ws/skills/$name"
done

# The wizard's scaffold is not memory. It is a placeholder with an empty
# directive and a link to the docs, so the first deploy has to seed straight
# over it; once a real file is in place this never matches again.
is_wizard_scaffold() {
  grep -q '^# USER.md - User Model' "$1" 2>/dev/null
}

# Ichabod's files. Seeded once and never clobbered again — after the first
# deploy these hold memory that only exists on the box.
for f in USER.md MEMORY.md; do
  if [ -e "$ws/$f" ] && ! is_wizard_scaffold "$ws/$f"; then
    echo "kept     $ws/$f (agent-owned)"
  else
    install -o openclaw -g openclaw -m 0644 "$src/workspace/$f" "$ws/$f"
    echo "seeded   $ws/$f"
  fi
done

# Claude Code's own settings, which OpenClaw reads because CLAUDE_CLI_DEFAULT_ARGS
# passes `--setting-sources user`. The deny list is the point: a denied tool is
# dropped from the preamble entirely rather than merely blocked, so the four
# tools no session has ever called stop costing ~6,400 tokens on every pass.
# Measured 2026-09-11: director preamble 61,122 -> 54,711.
install -d -o openclaw -g openclaw /home/openclaw/.claude
install -o openclaw -g openclaw -m 0644 "$src/claude/settings.json" /home/openclaw/.claude/settings.json
echo "installed /home/openclaw/.claude/settings.json"

# mail_reader gets one file and no memory. It is a per-message membrane, not a
# durable worker, so there is nothing for it to remember between sessions and
# nothing it is allowed to write. Zach owns this file the same way he owns the
# three above.
install -o openclaw -g openclaw -m 0644 "$src/workspace-mail-reader/AGENTS.md" "$mr/AGENTS.md"
echo "installed $mr/AGENTS.md"

# The wizard's birth ritual asks the agent to choose its own name and vibe.
# Ichabod's identity is decided, so the file can only cause drift.
if [ -e "$ws/BOOTSTRAP.md" ]; then
  rm -f "$ws/BOOTSTRAP.md"
  echo "removed  $ws/BOOTSTRAP.md"
fi

rm -rf "$templates/agent-workspace"
cp -R "$src/templates/agent-workspace" "$templates/agent-workspace"
rm -rf "$templates/app"
cp -R "$src/templates/app" "$templates/app"

# The three recurring passes and the director's condition script. Files only —
# `scripts/configure-automations` is what registers them with the scheduler.
autos=/srv/ichabod/automations
install -d -o openclaw -g openclaw "$autos"
for f in "$src"/automations/*.md; do
  install -o openclaw -g openclaw -m 0644 "$f" "$autos/$(basename "$f")"
done
echo "installed $autos"
install -o openclaw -g openclaw -m 0755 "$src/templates/new-agent" "$templates/new-agent"
install -o openclaw -g openclaw -m 0755 "$src/templates/new-agent-test" "$templates/new-agent-test"
chown -R openclaw:openclaw "$templates"
echo "installed $templates"
