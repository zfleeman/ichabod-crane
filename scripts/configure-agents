#!/usr/bin/env bash
# Write the agent roster into openclaw.json and restart the Gateway.
#
# Run from a checkout, on Zach's laptop. Everything here is idempotent, so
# rerunning it after a config restore is the intended way to get back to a
# known roster rather than clicking through the Control UI.
#
# `openclaw config set` is the typed way to write openclaw.json — the checklist
# rule is that the file is never hand-edited. Values are passed as JSON with
# --strict-json because plain value mode reports success without validating.
#
# Usage: scripts/configure-agents

set -euo pipefail

export AWS_PROFILE="${AWS_PROFILE:-ZACH-ROOT}"
export AWS_PAGER=""

cd "$(dirname "$0")/.."
instance="$(tofu -chdir=tofu output -raw instance_id)"

# The remote half. Written here as a plain script so the quoting stays legible;
# it rides over base64 the same way install-workspace does.
read -r -d '' remote_script <<'REMOTE' || true
set -euo pipefail
oc() { sudo -iu openclaw openclaw "$@"; }

# A dated backup before the first write, so a bad roster is one cp away from
# being undone. Kept alongside the ones earlier sections left.
sudo -iu openclaw cp /home/openclaw/.openclaw/openclaw.json \
  "/home/openclaw/.openclaw/openclaw.json.pre-agents-$(date +%Y%m%d-%H%M%S)"

# Explicit ownership: an agent exists because it is listed here, not because
# something inferred it from a workspace directory on disk.
oc config set agents.ownership '"explicit"' --strict-json

# ichabod: unsandboxed on purpose. Section 8 already set tools.exec.*; this is
# the per-agent half of the same decision.
oc config set agents.entries.ichabod.workspace '"/home/openclaw/.openclaw/workspace"' --strict-json
oc config set agents.entries.ichabod.sandbox '{"mode":"off"}' --strict-json

# mail_reader: registered only if it is not already in the roster. `agents add`
# fails on an existing id, and this script has to be safe to rerun.
if ! oc agents list 2>/dev/null | grep -q mail_reader; then
  oc agents add mail_reader --non-interactive \
    --workspace /home/openclaw/.openclaw/workspace-mail-reader
fi

# The membrane. Sandboxed to the session with no workspace access, and a
# minimal tool profile whose only useful mutation is creating a triage card.
# The deny list is belt and braces: profile "minimal" should already exclude
# these, but naming them means a future default change cannot quietly widen it.
# Sonnet, not the Opus default. mail_reader does one bounded, well-specified
# job on every admitted message, and the cheaper model is the right size for
# it. Set per-agent rather than in the UI so a config restore brings it back.
oc config set agents.entries.mail_reader.model '{"primary":"anthropic/claude-sonnet-5"}' --strict-json

oc config set agents.entries.mail_reader.workspace '"/home/openclaw/.openclaw/workspace-mail-reader"' --strict-json
oc config set agents.entries.mail_reader.sandbox '{"mode":"all","scope":"session","workspaceAccess":"none"}' --strict-json
oc config set agents.entries.mail_reader.tools '{"profile":"minimal","allow":["session_status","workboard_create"],"deny":["group:fs","group:runtime","group:web","browser","cron","gateway","nodes"]}' --strict-json

# The agent tool profile above and the sandbox tool policy are two different
# layers. `sandbox explain` showed exec, read, write, edit and apply_patch
# still allowed by the sandbox defaults, which is a shell inside the container
# even though the profile is "minimal". mail_reader is the one agent that
# reads text written by someone other than Zach, so close that layer too.
# This list REPLACES the sandbox defaults rather than merging with them, so it
# has to restate the defaults it still wants. Setting only the six exec-ish
# entries silently dropped canvas, computer, mobile_ui, automations, and every
# chat channel from the deny list.
oc config set agents.entries.mail_reader.tools.sandbox.tools.deny '["exec","process","read","write","edit","apply_patch","browser","canvas","computer","mobile_ui","nodes","automations","gateway","feishu","googlechat","nostr","buzz","msteams","mattermost","nextcloud-talk","matrix","raft","a2a","line","zalo","clickclack","zalouser","sms","synology-chat","tlon","discord","imessage","irc","reef","signal","slack","telegram","twitch","whatsapp"]' --strict-json

oc config validate

# Config is read at start, so the roster is not live until this returns.
sudo -iu openclaw systemctl --user restart openclaw-gateway
sleep 5
sudo -iu openclaw systemctl --user is-active openclaw-gateway

echo "=== roster ==="
oc agents list
REMOTE

payload="$(printf '%s' "$remote_script" | base64 | tr -d '\n')"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

remote="echo $payload | base64 -d > /tmp/configure-agents.sh && bash /tmp/configure-agents.sh"
printf '{"commands":["%s"]}' "$remote" > "$tmp/params.json"

command_id="$(aws ssm send-command --instance-ids "$instance" \
  --document-name AWS-RunShellScript \
  --parameters "file://$tmp/params.json" \
  --query Command.CommandId --output text)"
echo "sent $command_id, waiting..."

status=Pending
for _ in $(seq 45); do
  status="$(aws ssm get-command-invocation --command-id "$command_id" --instance-id "$instance" \
    --query Status --output text 2>/dev/null || echo Pending)"
  case "$status" in InProgress | Pending | Delayed) sleep 2 ;; *) break ;; esac
done

aws ssm get-command-invocation --command-id "$command_id" --instance-id "$instance" \
  --query '[StandardOutputContent,StandardErrorContent]' --output text

[ "$status" = "Success" ] || { echo "configure failed: $status" >&2; exit 1; }
