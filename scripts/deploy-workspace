#!/usr/bin/env bash
# Ship the workspace policy files and the agent template to the box.
#
# Run from a checkout, on Zach's laptop. SSM has no file copy, so the payload
# rides over as base64 inside a run-command — a few KB of Markdown against a
# 100 KB parameter limit. install-workspace, unpacked on the far side, is what
# decides which files get overwritten and which are only seeded.
#
# Usage: scripts/deploy-workspace

set -euo pipefail

# Same defaults the Makefile exports, so this behaves identically either way.
export AWS_PROFILE="${AWS_PROFILE:-ZACH-ROOT}"
export AWS_PAGER=""

cd "$(dirname "$0")/.."
[ -f workspace/AGENTS.md ] || { echo "no workspace/AGENTS.md — run this from a checkout" >&2; exit 1; }

instance="$(tofu -chdir=tofu output -raw instance_id)"
payload="$(tar czf - workspace templates scripts | base64 | tr -d '\n')"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# Kept free of quotes and backslashes so it needs no JSON escaping.
remote="rm -rf /tmp/ichabod-deploy && mkdir -p /tmp/ichabod-deploy && echo $payload | base64 -d | tar xzf - -C /tmp/ichabod-deploy && bash /tmp/ichabod-deploy/scripts/install-workspace"
printf '{"commands":["%s"]}' "$remote" > "$tmp/params.json"

command_id="$(aws ssm send-command --instance-ids "$instance" \
  --document-name AWS-RunShellScript \
  --parameters "file://$tmp/params.json" \
  --query Command.CommandId --output text)"
echo "sent $command_id, waiting..."

status=Pending
for _ in $(seq 30); do
  status="$(aws ssm get-command-invocation --command-id "$command_id" --instance-id "$instance" \
    --query Status --output text 2>/dev/null || echo Pending)"
  case "$status" in InProgress | Pending | Delayed) sleep 2 ;; *) break ;; esac
done

aws ssm get-command-invocation --command-id "$command_id" --instance-id "$instance" \
  --query '[StandardOutputContent,StandardErrorContent]' --output text

[ "$status" = "Success" ] || { echo "deploy failed: $status" >&2; exit 1; }
