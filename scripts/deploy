#!/usr/bin/env bash
# Ship the committed home/ to /home/ichabod on the box. `make deploy` runs this from Zach's laptop.
#
# SSM has no file copy, so the payload rides over as base64 inside a run-command, and
# install-home, unpacked on the far side, decides what is installed, seeded, or refused.
# Usage: scripts/deploy            FORCE=1 scripts/deploy overwrites files Ichabod changed on the box
set -euo pipefail

# Same defaults the Makefile exports, so this behaves identically either way.
export AWS_PROFILE="${AWS_PROFILE:-ZACH-ROOT}"
export AWS_PAGER=""

cd "$(dirname "$0")/.."

# Deploy what is committed, so the box always matches a commit someone can read.
if [ -n "$(git status --porcelain -- home scripts/install-home)" ]; then
  echo "home/ or scripts/install-home has uncommitted changes; commit them first" >&2
  exit 1
fi
commit="$(git rev-parse --short HEAD)"

instance="$(tofu -chdir=tofu output -raw instance_id)"
payload="$(git archive --format=tar.gz HEAD home scripts/install-home | base64 | tr -d '\n')"
# SSM caps a run-command's parameters at about 100 KB.
[ "${#payload}" -lt 90000 ] || { echo "payload is ${#payload} bytes, too close to SSM's limit" >&2; exit 1; }

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# Kept free of quotes and backslashes so it needs no JSON escaping.
force="${FORCE:-0}"
[[ "$force" =~ ^[01]$ ]] || { echo "FORCE must be 0 or 1" >&2; exit 1; }
remote="d=\$(mktemp -d) && echo $payload | base64 -d | tar xzf - --no-same-owner -C \$d && FORCE=$force bash \$d/scripts/install-home $commit; rc=\$?; rm -rf \$d; exit \$rc"
printf '{"commands":["%s"]}' "$remote" > "$tmp/params.json"

command_id="$(aws ssm send-command --instance-ids "$instance" \
  --document-name AWS-RunShellScript \
  --parameters "file://$tmp/params.json" \
  --query Command.CommandId --output text)"
echo "deploying $commit as $command_id, waiting..."

status=Pending
for _ in $(seq 30); do
  status="$(aws ssm get-command-invocation --command-id "$command_id" --instance-id "$instance" \
    --query Status --output text 2>/dev/null || echo Pending)"
  case "$status" in InProgress | Pending | Delayed) sleep 2 ;; *) break ;; esac
done

aws ssm get-command-invocation --command-id "$command_id" --instance-id "$instance" \
  --query '[StandardOutputContent,StandardErrorContent]' --output text

[ "$status" = "Success" ] || { echo "deploy failed: $status" >&2; exit 1; }
