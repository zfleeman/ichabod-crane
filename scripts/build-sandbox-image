#!/usr/bin/env bash
# Build the Docker image OpenClaw's sandbox runs agents inside.
#
# Run from a checkout, on Zach's laptop. OpenClaw ships scripts/sandbox-setup.sh
# in its source repo, but the npm package does not include it, so the Dockerfile
# is reproduced here from the docs. Without this image any sandboxed agent fails
# with "Sandbox image not found" — which is how we learned mail_reader had never
# been sandboxed at all.
#
# The image is deliberately boring: no network tools beyond curl, no node, no
# docker client. It is where untrusted email gets read.
#
# Usage: scripts/build-sandbox-image

set -euo pipefail

export AWS_PROFILE="${AWS_PROFILE:-ZACH-ROOT}"
export AWS_PAGER=""

cd "$(dirname "$0")/.."
instance="$(tofu -chdir=tofu output -raw instance_id)"

read -r -d '' remote_script <<'REMOTE' || true
set -euo pipefail

# Matches agents.defaults.sandbox.docker.image, which OpenClaw defaults to.
# Changing the tag here means changing it there too.
sudo -iu openclaw docker build -t openclaw-sandbox:bookworm-slim - <<'DOCKERFILE'
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
  bash ca-certificates curl git jq python3 ripgrep \
  && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --shell /bin/bash sandbox
USER sandbox
WORKDIR /home/sandbox
CMD ["sleep", "infinity"]
DOCKERFILE

echo "=== images ==="
sudo -iu openclaw docker images openclaw-sandbox
REMOTE

payload="$(printf '%s' "$remote_script" | base64 | tr -d '\n')"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

remote="echo $payload | base64 -d > /tmp/build-sandbox-image.sh && bash /tmp/build-sandbox-image.sh"
printf '{"commands":["%s"]}' "$remote" > "$tmp/params.json"

command_id="$(aws ssm send-command --instance-ids "$instance" \
  --document-name AWS-RunShellScript \
  --parameters "file://$tmp/params.json" \
  --query Command.CommandId --output text)"
echo "sent $command_id, waiting..."

# Image builds pull a base layer and run apt, so this waits longer than the
# other scripts here.
status=Pending
for _ in $(seq 90); do
  status="$(aws ssm get-command-invocation --command-id "$command_id" --instance-id "$instance" \
    --query Status --output text 2>/dev/null || echo Pending)"
  case "$status" in InProgress | Pending | Delayed) sleep 4 ;; *) break ;; esac
done

aws ssm get-command-invocation --command-id "$command_id" --instance-id "$instance" \
  --query '[StandardOutputContent,StandardErrorContent]' --output text

[ "$status" = "Success" ] || { echo "build failed: $status" >&2; exit 1; }
