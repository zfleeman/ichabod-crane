#!/usr/bin/env bash
# Ship a built plugin to the box, install it, and write its config.
#
# Run from a checkout, on Zach's laptop, after `npm run plugin:build` in the
# plugin directory. Idempotent: rerunning replaces the installed copy and
# rewrites the same config.
#
# The config comes from plugins/<id>/config.json so it sits next to the plugin
# it configures and this script stays the same for every plugin. Why each field
# is what it is belongs in that plugin's README.
#
# Usage: scripts/install-plugin <plugin-id>

set -euo pipefail

export AWS_PROFILE="${AWS_PROFILE:-ZACH-ROOT}"
export AWS_PAGER=""

cd "$(dirname "$0")/.."
id="${1:-}"
[ -n "$id" ] || { echo "usage: scripts/install-plugin <plugin-id>" >&2; exit 1; }
plugin="plugins/$id"
[ -f "$plugin/dist/index.js" ] || {
  echo "no build output — run: (cd $plugin && npm install && npm run plugin:build)" >&2
  exit 1
}
[ -f "$plugin/config.json" ] || { echo "missing $plugin/config.json" >&2; exit 1; }

instance="$(tofu -chdir=tofu output -raw instance_id)"

# The lock file is far past the 100 KB SSM parameter limit, so the box resolves
# runtime dependencies itself. Versions are pinned to exactly what this checkout
# resolved, so the box gets the tree the tests ran against rather than whatever
# npm feels like today.
staging="$(mktemp -d)"
tmp="$(mktemp -d)"
trap 'rm -rf "$staging" "$tmp"' EXIT
mkdir -p "$staging/$id"
cp -R "$plugin/dist" "$staging/$id/dist"
cp "$plugin/openclaw.plugin.json" "$staging/$id/openclaw.plugin.json"

python3 - "$plugin" "$staging/$id/package.json" <<'PY'
import json, pathlib, sys
src, dest = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
pkg = json.loads((src / "package.json").read_text())
pinned = {}
for name in pkg["dependencies"]:
    installed = json.loads((src / "node_modules" / name / "package.json").read_text())
    pinned[name] = installed["version"]
dest.write_text(json.dumps({
    "name": pkg["name"],
    "version": pkg["version"],
    "type": "module",
    "private": True,
    "dependencies": pinned,
    "openclaw": pkg["openclaw"],
}, indent=2) + "\n")
print("pinned:", ", ".join(f"{k}@{v}" for k, v in pinned.items()), file=sys.stderr)
PY

payload="$(COPYFILE_DISABLE=1 tar --no-xattrs -czf - -C "$staging" "$id" | base64 | tr -d '\n')"
config_b64="$(base64 < "$plugin/config.json" | tr -d '\n')"

read -r -d '' remote_body <<'REMOTE' || true
oc() { sudo -iu openclaw openclaw "$@"; }

sudo -iu openclaw cp /home/openclaw/.openclaw/openclaw.json \
  "/home/openclaw/.openclaw/openclaw.json.pre-$id-$(date +%Y%m%d-%H%M%S)"

sudo -iu openclaw mkdir -p /home/openclaw/plugins
sudo -iu openclaw rm -rf "/home/openclaw/plugins/$id"
sudo -iu openclaw tar xzf /tmp/plugin.tgz -C /home/openclaw/plugins
sudo -iu openclaw sh -c "cd /home/openclaw/plugins/$id && npm install --omit=dev --no-audit --no-fund --loglevel=error"

# --force is required for any local path: OpenClaw refuses sources outside
# ClawHub review without it. The source is plugins/<id> in this repo, built and
# tested in the same commit that ships it.
#
# --accept-capabilities consents to the plugin's declared surface, which for
# these plugins is a list of tool names and nothing else. OpenClaw re-prompts if
# that surface ever changes, so the consent does not silently cover a future
# version.
oc plugins install "/home/openclaw/plugins/$id" --force --accept-capabilities

# The config write is validated against the plugin registry, and the registry
# does not know this plugin's manifest until the Gateway reloads. Skip this
# restart and the write fails with `password: must be string`, because the
# contract declaring password as a SecretRef surface has not been read yet.
sudo -iu openclaw systemctl --user restart openclaw-gateway
sleep 8

echo "$config_b64" | base64 -d > /tmp/plugin-config.json
oc config set "plugins.entries.$id.config" "$(cat /tmp/plugin-config.json)" --strict-json
rm -f /tmp/plugin-config.json

oc plugins enable "$id" --accept-capabilities
oc config validate

sudo -iu openclaw systemctl --user restart openclaw-gateway
sleep 8
sudo -iu openclaw systemctl --user is-active openclaw-gateway

echo "=== plugin ==="
oc plugins list | grep -i " $id " || echo "$id NOT LISTED"

# An unresolved ref would make every call fail; catch it here rather than at
# the first tool call.
audit="$(oc secrets audit 2>&1)"
echo "$audit" | head -1
echo "$audit" | grep -q "unresolved=0" \
  || { echo "unresolved SecretRef: $id would fail on every call" >&2; exit 1; }
REMOTE

remote_script="set -euo pipefail
id='$id'
config_b64='$config_b64'
$remote_body"

script_b64="$(printf '%s' "$remote_script" | base64 | tr -d '\n')"
remote="echo $payload | base64 -d > /tmp/plugin.tgz && echo $script_b64 | base64 -d > /tmp/install-plugin.sh && bash /tmp/install-plugin.sh"
printf '{"commands":["%s"]}' "$remote" > "$tmp/params.json"

command_id="$(aws ssm send-command --instance-ids "$instance" \
  --document-name AWS-RunShellScript \
  --parameters "file://$tmp/params.json" \
  --query Command.CommandId --output text)"
echo "sent $command_id, waiting..."

aws ssm wait command-executed --command-id "$command_id" --instance-id "$instance" 2>/dev/null || true

aws ssm get-command-invocation --command-id "$command_id" --instance-id "$instance" \
  --query '[StandardOutputContent,StandardErrorContent]' --output text

status="$(aws ssm get-command-invocation --command-id "$command_id" --instance-id "$instance" \
  --query Status --output text)"
[ "$status" = "Success" ] || { echo "install-plugin $id failed: $status" >&2; exit 1; }
