# Every secret the scripts read. Set each one from the laptop with `make secret NAME=<name>`, which
# keeps the value off command lines and out of SSM's command history.
# The ChatGPT login is not here: Pi keeps it in /home/ichabod/.pi/agent/auth.json.

# Not secret. The board's public address.
KANBOARD_URL=https://ichabod-board.zfleeman.com

# The ichabod Kanboard user's personal API token.
KANBOARD_TOKEN=

# Fine-grained GitHub token scoped to the ich4bod account. gh reads it from the environment.
GH_TOKEN=

# Fastmail app password for ichabod@ichabod-crane.net. receive-mail reads with it and send-mail sends with it.
# An app password rather than OAuth: scoped to mail, revocable on its own, and it does not expire mid-week.
MAIL_PASSWORD=
