# Every secret the scripts read. Bootstrap by writing /home/ichabod/.config/ichabod/env (mode 0600)
# over `make shell`, one line at a time with `read -rs`, copying each value from 1Password.
# The ChatGPT login is not here: Pi keeps it in /home/ichabod/.pi/agent/auth.json.

# Not secret. The board's public address.
KANBOARD_URL=https://ichabod-board.zfleeman.com

# The ichabod Kanboard user's personal API token.
KANBOARD_TOKEN=

# Fine-grained GitHub token scoped to the ich4bod account.
GH_TOKEN=

# Fastmail app password used by intake to read mail.
IMAP_PASSWORD=

# A second Fastmail app password used by notify to send, so sending can be revoked without breaking intake.
SMTP_PASSWORD=
