# Every secret the scripts read. Set each one from the laptop with `make secret NAME=<name>`;
# docs/ICHABOD-GUIDE.md, "Secrets", explains why that is the safe path.
# The ChatGPT login is not here: Pi keeps it in /home/ichabod/.pi/agent/auth.json.

# Not secret. The board's public address.
KANBOARD_URL=https://ichabod-board.zfleeman.com

# The ichabod Kanboard user's personal API token.
KANBOARD_TOKEN=

# Fine-grained GitHub token scoped to the ich4bod account.
GH_TOKEN=

# Fastmail app password used by receive-mail to read mail.
IMAP_PASSWORD=

# A second Fastmail app password used by send-mail, so sending can be revoked without breaking receive-mail.
SMTP_PASSWORD=
