#!/usr/bin/env bash
# set-secret <NAME>   prompt for a value without echoing it, and write NAME='value' into the env file.
# Zach runs this through `make secret NAME=...`, so the value is typed, never put on a command line.
set -euo pipefail
name="${1:-}"
env=/home/ichabod/.config/ichabod/env

[[ "$name" =~ ^[A-Z][A-Z0-9_]*$ ]] || { echo "set-secret: usage: set-secret NAME (capitals, digits, underscores)" >&2; exit 2; }

IFS= read -rsp "$name (input hidden): " value
echo
[ -n "$value" ] || { echo "set-secret: empty value, nothing written" >&2; exit 1; }
# Single quotes keep the value literal when the file is sourced, so a quote inside it cannot be allowed.
[[ "$value" != *"'"* ]] || { echo "set-secret: value contains a single quote, nothing written" >&2; exit 1; }

umask 077
mkdir -p "$(dirname "$env")"
touch "$env"
# Drop any old line for this name, append the new one, and swap the file in whole.
{ grep -v "^$name=" "$env" || true; printf "%s='%s'\n" "$name" "$value"; } > "$env.tmp"
chmod 600 "$env.tmp"
mv "$env.tmp" "$env"
echo "set-secret: $name written to $env"
