#!/usr/bin/python3
# receive-mail   fetch mail -> gate -> a tool-less pi describes it -> validate -> board createTask.
# The one safety-critical path on the box; docs/MEMBRANE.md is its specification. Cron runs this.
#
# Every flag on the reader line is load-bearing (MEMBRANE.md, "The flags, one at a time"):
#   --no-tools            the reader can act without it; this is the whole boundary
#   env -i                the reader would inherit GH_TOKEN, KANBOARD_TOKEN, IMAP_PASSWORD, SMTP_PASSWORD
#   PI_CODING_AGENT_DIR   the ChatGPT login, the only credential the reader gets
#   --no-context-files    AGENTS.md would hand the reader a map of Ichabod's authority
#   --no-skills, --no-extensions   skills are the same map, and an extension can add tools back
#   --no-session          hostile text would pile up in ~/.pi/agent/sessions/
# Dropping env -i "to tidy up" is the most likely way this regresses. Don't.
#
# Needs python3-dkim and python3-dnspython from apt.
import email
import email.policy
import fcntl
import imaplib
import json
import re
import subprocess
import sys
import time
from datetime import datetime, timezone

import dkim
import dns.exception
import dns.resolver

HOME = "/home/ichabod"
IMAP_HOST = "imap.fastmail.com"
IMAP_USER = "ichabod@ichabod-crane.net"
ALLOWED_SENDERS = {"zfleeman@gmail.com"}
MAX_AGE_SECONDS = 48 * 3600
MAX_BODY_CHARS = 100_000
REJECTED_FOLDER = "Rejected"
QUARANTINE_FOLDER = "Quarantine"
ARCHIVE_FOLDER = "Archive"
STATE_FILE = f"{HOME}/.local/state/receive-mail-seen.jsonl"
LOCK_FILE = f"{HOME}/.local/state/receive-mail.lock"

READER = [
    "/usr/bin/env", "-i", "HOME=/tmp", "PATH=/usr/bin",
    f"PI_CODING_AGENT_DIR={HOME}/.pi/agent",
    "pi", "-p", "--no-tools", "--no-skills", "--no-extensions", "--no-session", "--no-context-files",
    f"@{HOME}/prompts/membrane.md",
]  # fmt: skip
READER_TIMEOUT_SECONDS = 600
# Stop after this many reader calls in one run, so a backlog cannot drain the Plus quota the passes share.
MAX_READS_PER_RUN = 10

# The reader's whole contract: these four fields, these types, nothing else. Never add a field that
# names an agent, a command, a schedule, a URL or a budget (MEMBRANE.md, "Rules").
SCHEMA = {"title": str, "summary": str, "sender": str, "suspicious": bool}
MAX_FIELD_CHARS = {"title": 200, "summary": 4000, "sender": 200}


class Quarantine(Exception):
    """The message passed the gate but the reader's output could not be trusted into a card."""


def log(uid, outcome, reason=""):
    # Fixed strings only. Hostile text stays out of log/, which the passes read.
    print(f"{datetime.now(timezone.utc).isoformat(timespec='seconds')} uid={uid} {outcome} {reason}".rstrip())


def tell_zach(subject, body):
    # send-mail is the only way mail leaves the box. If it fails, receive-mail fails, so health sees it.
    subprocess.run([f"{HOME}/bin/send-mail", subject], input=body.encode(), check=True, timeout=120)


def load_env():
    # The same file the bash wrappers source, in set-secret's NAME='value' format.
    env = {}
    with open(f"{HOME}/.config/ichabod/env") as f:
        for line in f:
            name, sep, value = line.strip().partition("=")
            if sep and not name.startswith("#"):
                env[name] = value.strip("'\"")
    return env


def read_state():
    seen_uids, seen_message_ids = set(), set()
    try:
        with open(STATE_FILE) as f:
            for line in f:
                row = json.loads(line)
                seen_uids.add((row["uidvalidity"], row["uid"]))
                if row["message_id"]:
                    seen_message_ids.add(row["message_id"])
    except FileNotFoundError:
        pass
    return seen_uids, seen_message_ids


def record(uidvalidity, uid, message_id, outcome):
    with open(STATE_FILE, "a") as f:
        row = {"uidvalidity": uidvalidity, "uid": uid, "message_id": message_id, "outcome": outcome}
        f.write(json.dumps(row | {"at": int(time.time())}) + "\n")


def gate(msg, raw, received_at):
    """Return None if the message may be read, or a fixed-string reason it may not."""
    froms = msg.get_all("From") or []
    if len(froms) != 1 or froms[0].defects or len(froms[0].addresses) != 1:
        return "not exactly one From header with one address"
    address = froms[0].addresses[0].addr_spec.lower()
    if address not in ALLOWED_SENDERS:
        return "sender not on the allowlist"
    if time.time() - received_at > MAX_AGE_SECONDS:
        return "older than 48 hours"
    if not dmarc_passes(raw, address.rpartition("@")[2]):
        return "DMARC did not pass with alignment"
    return None


def dmarc_passes(raw, from_domain):
    # Verified here against the raw message, never read off the provider's Authentication-Results.
    # SPF cannot be checked after delivery, so a pass means a DKIM signature that verifies and whose
    # d= is exactly the From domain. That is strict alignment, stricter than DMARC's relaxed default.
    try:
        records = dns.resolver.resolve(f"_dmarc.{from_domain}", "TXT")
    except dns.exception.DNSException:
        return False
    if not any(b"".join(r.strings).startswith(b"v=DMARC1") for r in records):
        return False

    for idx in range(len(email.message_from_bytes(raw).get_all("DKIM-Signature") or [])):
        d = dkim.DKIM(raw, minkey=1024)
        try:
            if not d.verify(idx=idx):
                continue
        except Exception:  # any failure to verify is a signature that does not count
            continue
        # l= signs only part of the body, so anything appended after it would ride on the signature.
        aligned = d.domain.decode("ascii", "replace").lower() == from_domain
        if aligned and b"from" in d.include_headers and b"l" not in d.signature_fields:
            return True
    return False


def reader_input(msg):
    part = msg.get_body(preferencelist=("plain", "html"))
    if part is None:
        raise Quarantine("no text or HTML body")
    try:
        body = part.get_content()
    except (LookupError, ValueError):
        raise Quarantine("body could not be decoded") from None
    if len(body) > MAX_BODY_CHARS:
        raise Quarantine(f"body is over {MAX_BODY_CHARS} characters")
    return f"Subject: {msg.get('Subject', '')}\n\n{body}"


def parse_reader_output(text):
    # Models wrap JSON in fences, so strip one pair. Anything else unparseable is quarantined, not repaired.
    text = text.strip()
    fenced = re.fullmatch(r"```(?:json)?\s*\n(.*)\n```", text, flags=re.DOTALL)
    if fenced:
        text = fenced.group(1)

    def no_duplicate_keys(pairs):
        keys = [k for k, _ in pairs]
        if len(keys) != len(set(keys)):
            raise Quarantine("reader output repeats a key")
        return dict(pairs)

    try:
        card = json.loads(text, object_pairs_hook=no_duplicate_keys)
    except json.JSONDecodeError:
        raise Quarantine("reader output is not JSON") from None
    if not isinstance(card, dict) or set(card) != set(SCHEMA):
        raise Quarantine("reader output does not have exactly the four fields")
    for field, kind in SCHEMA.items():
        if type(card[field]) is not kind:
            raise Quarantine(f"reader field {field} has the wrong type")
    for field, limit in MAX_FIELD_CHARS.items():
        if not card[field].strip() or len(card[field]) > limit:
            raise Quarantine(f"reader field {field} is empty or over {limit} characters")
    return card


def run_reader(msg):
    result = subprocess.run(
        READER, input=reader_input(msg).encode(), capture_output=True, timeout=READER_TIMEOUT_SECONDS
    )
    # A failed or timed-out pi is an outage, not a verdict: raise, leave the message unread, retry next run.
    # A message that keeps failing ages past the 48-hour gate and is rejected.
    if result.returncode != 0:
        raise RuntimeError(f"pi exited {result.returncode}")
    output = result.stdout.decode("utf-8", "replace")
    try:
        return parse_reader_output(output)
    except Quarantine:
        # By hand (MEMBRANE.md's tests), show what the reader printed. From cron, keep it out of log/.
        if sys.stderr.isatty():
            print(output, file=sys.stderr)
        raise


def file_card(card, address, message_id, date_header, received_at):
    # Column and tags are fixed here. No column_id means the first column, which is triage.
    received = datetime.fromtimestamp(received_at, timezone.utc).isoformat(timespec="seconds")
    description = "\n".join([
        f"**From:** {address} (allowlisted, DMARC verified by receive-mail)",
        f"**Message-ID:** {message_id or 'not given'}",
        f"**Date header:** {date_header or 'not given'}",
        f"**Received:** {received}",
        f"**Original sender, per the reader:** {card['sender']}",
        f"**Suspicious, per the reader:** {'yes' if card['suspicious'] else 'no'}",
        "",
        card["summary"],
    ])  # fmt: skip
    tags = ["email", "suspicious"] if card["suspicious"] else ["email"]
    params = {"project_id": 1, "title": card["title"], "description": description, "tags": tags}
    # An argument list, never a shell string: the card's text is data copied into fields.
    try:
        result = subprocess.run(
            [f"{HOME}/bin/board", "createTask", json.dumps(params)], capture_output=True, check=True, timeout=60
        )
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
        # Re-raised without the original, whose message would carry the card text into log/.
        raise RuntimeError("board createTask failed") from None
    task_id = json.loads(result.stdout)
    if not isinstance(task_id, int) or isinstance(task_id, bool) or task_id <= 0:
        raise RuntimeError("board createTask did not return a task id")
    return task_id


def header_text(msg, name, limit=200):
    # Headers receive-mail writes onto the card itself, flattened to one bounded line.
    value = " ".join(str(msg.get(name, "")).split())
    return value[:limit]


def process(imap, uid, uidvalidity, seen_uids, seen_message_ids):
    """Handle one unread message. Returns True if the reader was called, which counts toward MAX_READS_PER_RUN."""
    _, date_data = imap.uid("FETCH", uid, "(INTERNALDATE)")
    received_at = time.mktime(imaplib.Internaldate2tuple(date_data[0]))
    _, body_data = imap.uid("FETCH", uid, "(BODY.PEEK[])")
    raw = body_data[0][1]
    msg = email.message_from_bytes(raw, policy=email.policy.default)
    message_id = header_text(msg, "Message-ID")

    # UIDs are per folder, so a filed message dragged back from Archive has a new one; Message-ID still matches.
    if (uidvalidity, int(uid)) in seen_uids or (message_id and message_id in seen_message_ids):
        imap.uid("STORE", uid, "+FLAGS", "(\\Seen)")
        log(uid, "skipped", "already processed")
        return False
    # Claimed in memory now, so a second copy of the same Message-ID later in this run is skipped too.
    seen_uids.add((uidvalidity, int(uid)))
    if message_id:
        seen_message_ids.add(message_id)

    reason = gate(msg, raw, received_at)
    if reason:
        imap.uid("MOVE", uid, REJECTED_FOLDER)
        record(uidvalidity, int(uid), message_id, "rejected")
        log(uid, "rejected", reason)
        return False

    # Past the gate: from here on, the body is read, but only by the reader.
    address = msg.get_all("From")[0].addresses[0].addr_spec.lower()
    try:
        card = run_reader(msg)
    except Quarantine as q:
        imap.uid("MOVE", uid, QUARANTINE_FOLDER)
        record(uidvalidity, int(uid), message_id, "quarantined")
        log(uid, "quarantined", str(q))
        tell_zach(
            "receive-mail quarantined a message",
            f"Message-ID: {message_id or 'not given'}\nReason: {q}\n\n"
            f"It is in the {QUARANTINE_FOLDER} folder. Read it yourself; no card was made.\n",
        )
        return True

    # Card first, then the record: a crash between them makes a duplicate card, never a lost request.
    task_id = file_card(card, address, message_id, header_text(msg, "Date"), received_at)
    record(uidvalidity, int(uid), message_id, "filed")
    # The card is now the record of the request, so the message leaves the inbox and nothing else needs IMAP.
    imap.uid("MOVE", uid, ARCHIVE_FOLDER)
    log(uid, "filed", f"task={task_id}{' suspicious' if card['suspicious'] else ''}")
    return True


def main():
    # One receive-mail at a time, so a slow reader call cannot overlap the next run and take the same message.
    lock = open(LOCK_FILE, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log("-", "skipped", "previous receive-mail still running")
        return 0

    # Fail closed and loud: a mailbox that cannot be opened must never look like a quiet day.
    try:
        password = load_env().get("IMAP_PASSWORD", "")
        if not password:
            raise ValueError("IMAP_PASSWORD is empty or missing")
        imap = imaplib.IMAP4_SSL(IMAP_HOST, timeout=60)
        imap.login(IMAP_USER, password)
    except (OSError, ValueError, imaplib.IMAP4.error) as e:
        # Only the exception type: an IMAP error can echo what was sent.
        log("-", "error", f"mailbox did not open: {type(e).__name__}")
        tell_zach(
            "receive-mail cannot open the mailbox",
            f"receive-mail could not log in to {IMAP_USER} ({type(e).__name__}). No mail is being read.\n"
            "If the app password is wrong or revoked, set a new one with: make secret NAME=IMAP_PASSWORD\n",
        )
        return 1

    try:
        for folder in (REJECTED_FOLDER, QUARANTINE_FOLDER, ARCHIVE_FOLDER):
            imap.create(folder)  # NO when it already exists, which is fine
        imap.select("INBOX")
        uidvalidity = int(imap.response("UIDVALIDITY")[1][0])
        _, data = imap.uid("SEARCH", "UNSEEN")
        seen_uids, seen_message_ids = read_state()
        reads = 0
        for uid in data[0].split():
            if reads == MAX_READS_PER_RUN:
                log("-", "stopped", f"reader called {MAX_READS_PER_RUN} times; the rest wait for the next run")
                break
            if process(imap, uid.decode(), uidvalidity, seen_uids, seen_message_ids):
                reads += 1
    finally:
        imap.logout()
    return 0


if __name__ == "__main__":
    sys.exit(main())
