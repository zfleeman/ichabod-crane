#!/usr/bin/env bash
# backup-workspace   commit workspace/ and push it to its private repo, refusing if a secret is staged.
# run-pass calls this after every pass.
set -euo pipefail
home=/home/ichabod

# route and work can finish at the same moment; one git at a time.
exec 9>"$home/.local/state/backup-workspace.lock"
flock -w 120 9

cd "$home/workspace"
git add -A
git diff --cached --quiet && exit 0

# Every secret value on the box: TOKEN/PASSWORD/KEY/SECRET lines in the env file, and Pi's login tokens.
secrets="$( {
  sed -nE 's/^[A-Z_]*(TOKEN|PASSWORD|KEY|SECRET)=//p' "$home/.config/ichabod/env" | sed -E 's/^"(.*)"$/\1/'
  jq -r '.. | strings' "$home/.pi/agent/auth.json"
} | awk 'length >= 12')"

# An empty pattern list would match every line, so only scan when there is something to scan for.
if [ -n "$secrets" ] && git diff --cached -U0 | grep -qFf <(printf '%s\n' "$secrets"); then
  git reset -q
  echo "backup-workspace: a secret value is staged in workspace/; nothing committed" >&2
  exit 1
fi

git commit -qm "Pass at $(date '+%F %H:%M')"
git push -q
