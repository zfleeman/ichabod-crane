# The shipped schedule. `make cron` installs it as /etc/cron.d/ichabod-schedule; `make deploy` never does.
# Ichabod's own crontab (`crontab -l` as ichabod) is separate and his to edit.
# Every job here has a heartbeat alarm in tofu/main.tf. Add one when you add a job, and change its hours when you change its schedule.
PATH=/home/ichabod/bin:/home/ichabod/.local/bin:/usr/local/bin:/usr/bin:/bin

*/30 * * * *     ichabod  /home/ichabod/bin/receive-mail >> /home/ichabod/log/receive-mail.log 2>&1
0 * * * *        ichabod  /home/ichabod/bin/usage >> /home/ichabod/log/usage.jsonl
# work runs at five and thirty-five past, so receive-mail and usage have usually finished what they started. A run still going skips the next.
5,35 * * * *     ichabod  /home/ichabod/bin/run work openai-codex/gpt-5.6-terra >> /home/ichabod/log/run.log 2>&1
# read-feeds runs at twenty past, between receive-mail's runs, and scout picks up its themes on its next run.
20 */12 * * *    ichabod  /home/ichabod/bin/read-feeds >> /home/ichabod/log/read-feeds.log 2>&1
# scout runs every two hours. What paces proposals is the backlog target in scout.md, not this schedule, so the
# frequency here only sets how long a new issue waits to become a card. Ten past keeps a regular run from taking
# the lock at 02:00 or 03:00, when the 8 p.m. runs below start: the burst gets the lock and the 02:10 run skips.
10 */2 * * *     ichabod  /home/ichabod/bin/run scout openai-codex/gpt-5.6-luna >> /home/ichabod/log/run.log 2>&1
# Five scout runs back to back at 8 p.m. Denver time, to fill the board overnight. The box is on UTC, so this fires at
# 02:00 and 03:00 and only the one that is 8 p.m. in Denver runs. Cron needs the % escaped. A run skipped by the lock is one fewer.
0 2,3 * * *      ichabod  [ "$(TZ=America/Denver date +\%H)" = 20 ] && for i in 1 2 3 4 5; do /home/ichabod/bin/run scout openai-codex/gpt-5.6-luna; done >> /home/ichabod/log/run.log 2>&1
# digest emails at 7 a.m. Denver time, which is 13:00 UTC in summer and 14:00 in winter, the same way.
0 13,14 * * *    ichabod  [ "$(TZ=America/Denver date +\%H)" = 07 ] && /home/ichabod/bin/run digest openai-codex/gpt-5.6-luna >> /home/ichabod/log/run.log 2>&1
# health runs at ten to the hour, so the jobs that start on the hour have finished and are counted.
50 * * * *       ichabod  /home/ichabod/bin/health >> /home/ichabod/log/health.log 2>&1
